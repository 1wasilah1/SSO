CREATE TABLE apps (
  id NUMBER PRIMARY KEY,
  name VARCHAR2(255) NOT NULL,
  description VARCHAR2(1000),
  created_at DATE DEFAULT SYSDATE,
  updated_at DATE DEFAULT SYSDATE
);

CREATE SEQUENCE apps_seq
  START WITH 1
  INCREMENT BY 1
  NOCACHE
  NOCYCLE;
  
  SELECT sequence_name FROM user_sequences WHERE sequence_name = 'APPS_SEQ';
  
  
  SELECT table_name FROM user_tables WHERE table_name = 'APPS';


CREATE TABLE apps_active (
    id NUMBER PRIMARY KEY,
    user_id NUMBER NOT NULL,
    app_id NUMBER NOT NULL,
    active_since TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (app_id) REFERENCES apps(id)
);

CREATE TABLE user_active_apps (
  id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  user_id NUMBER NOT NULL,
  app_id NUMBER NOT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
